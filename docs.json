{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Kviria",
  "theme": "maple",
  "colors": {
    "primary": "#e5e5e5",
    "light": "#ffffff",
    "dark": "#d4d4d4"
  },
  "favicon": {
    "light": "/images/favicon.ico",
    "dark": "/images/favicon.ico"
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/images/apple-icon.png",
    "dark": "/images/Logo(2).svg"
  },
  "navbar": {
    "links": [
      {
        "href": "https://kviria.com",
        "label": "Live demo"
      },
      {
        "href": "https://github.com/kviria",
        "label": "GitHub"
      },
      {
        "href": "mailto:hello@kviria.com",
        "label": "Contact"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://api.kviria.com/key"
    }
  },
  "errors": {
    "404": {
      "redirect": false
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ],
    "display": "header"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "agents",
          "voice",
          "api/mcp"
        ]
      },
      {
        "group": "API Reference",
        "pages": [
          "api/agent",
          "api/profile",
          "api/batch",
          "api/limits"
        ]
      },
      {
        "group": "Resources",
        "pages": [
          "data",
          "changelog"
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/kviria"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "Live demo",
            "href": "https://kviria.com"
          },
          {
            "label": "Get API Key",
            "href": "https://api.kviria.com/key"
          },
          {
            "label": "For agents",
            "href": "https://kviria.com/setup.md"
          },
          {
            "label": "Status",
            "href": "https://status.kviria.com"
          }
        ]
      },
      {
        "header": "Legal & Support",
        "items": [
          {
            "label": "Privacy Policy",
            "href": "https://kviria.com/privacy"
          },
          {
            "label": "Terms of Service",
            "href": "https://kviria.com/terms"
          },
          {
            "label": "hello@kviria.com",
            "href": "mailto:hello@kviria.com"
          }
        ]
      }
    ]
  },
  "background": {
    "color": {
      "dark": "#0a0a0a"
    }
  },
  "fonts": {
    "family": "Geist"
  }
}
